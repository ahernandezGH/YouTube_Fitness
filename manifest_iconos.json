{
  "manifest_version": 3,
  "name": "YouTube Fitness Tracker",
  "version": "1.1",
  "description": "Filtra y prioriza tus videos de entrenamiento de YouTube sin API Keys.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/feeds/videos.xml*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html"
}